<?xml version="1.0" encoding="UTF-8"?>
<!-- 测试用日志配置:仅输出到控制台,不写文件、不依赖 janino 条件表达式 -->
<configuration>

    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="console"/>
    </root>

    <logger name="com.alibaba.schedulerx.worker.log.logger.Log4j2Logger" level="OFF"/>
    <logger name="org.apache.logging.log4j.Logger" level="OFF"/>
</configuration>
